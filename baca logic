-- ⚙️ FUNGSI SCANNER
-- ==========================================
local scannedData = ""

local function updatePreview(text)
    scannedData = text
    if string.len(scannedData) > 2000 then
        previewBox.Text = string.sub(scannedData, 1, 2000) .. "\n\n... [Teks terlalu panjang, klik Save .TXT untuk melihat full]"
    else
        previewBox.Text = scannedData
    end
end

