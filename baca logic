local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

-- 🛡️ SISTEM BYPASS UI UNTUK DELTA & MOBILE EXECUTORS
local function GetSafeUIParent()
    local success, parent = pcall(function()
        if gethui then return gethui() end
        return CoreGui
    end)
    if success and parent then 
        return parent 
    end
    -- Fallback ke PlayerGui jika CoreGui diblokir executor
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local UIParent = GetSafeUIParent()

-- Hapus UI lama jika ada
if UIParent:FindFirstChild("DevScannerUI") then
    UIParent.DevScannerUI:Destroy()
end

