if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Tunggu sampai LocalPlayer dan PlayerGui benar-benar ada
repeat task.wait(0.1) until LocalPlayer ~= nil
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)

-- 🛡️ SISTEM BYPASS UI SUPER AMAN UNTUK DELTA & MOBILE
local function GetSafeUIParent()
    local parent = nil
    -- Coba pakai fungsi khusus executor (paling aman dari deteksi)
    pcall(function() parent = gethui() end)
    if parent then return parent end
    
    -- Coba masukkan ke CoreGui
    pcall(function() parent = game:GetService("CoreGui") end)
    if parent then return parent end
    
    -- Opsi terakhir: Masukkan langsung ke UI Player (Pasti berhasil)
    return PlayerGui
end

local UIParent = GetSafeUIParent()

-- Hapus UI lama jika ada supaya tidak dobel
pcall(function()
    if UIParent and UIParent:FindFirstChild("ActivityRecorderUI") then
        UIParent.ActivityRecorderUI:Destroy()
    end
end)

