btnScanRemotes.Parent = main
Instance.new("UICorner", btnScanRemotes).CornerRadius = UDim.new(0, 6)

btnScanRemotes.MouseButton1Click:Connect(function()
    btnScanRemotes.Text = "Scanning..."
    task.wait(0.1)
    
    local result = "-- [ HASIL SCAN REMOTE EVENT & FUNCTION ] --\n\n"
    local count = 0
    for _, v in pairs(game:GetDescendants()) do
        pcall(function()
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                result = result .. "Tipe: " .. v.ClassName .. "\n"
                result = result .. "Path: " .. v:GetFullName() .. "\n"
                result = result .. "Script Code: " .. v:GetFullName() .. ":FireServer()\n"
                result = result .. "-----------------------------------\n"
                count = count + 1
            end
        end)
    end
    result = result .. "\nTotal Ditemukan: " .. count
    updatePreview(result)
    btnScanRemotes.Text = "1. Scan All RemoteEvents"
end)

