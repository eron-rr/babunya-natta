-- ==========================================
-- ⚙️ LOGIC & RECORDING SYSTEM
-- ==========================================
local isRecording = false
local logData = ""
local recordConnections = {}

-- Fungsi untuk menambah log
local function addLog(action)
    if not isRecording then return end
    local timeStr = os.date("%H:%M:%S")
    local entry = string.format("[%s] %s\n", timeStr, action)
    
    logData = logData .. entry
    
    -- Update UI Text (Dibatasi agar tidak ngelag di HP)
    local lines = string.split(logData, "\n")
    if #lines > 50 then
        local displayData = ""
        for i = #lines - 50, #lines do
            displayData = displayData .. lines[i] .. "\n"
        end
        logBox.Text = displayData
    else
        logBox.Text = logData
    end
    
    -- Auto Scroll ke bawah
    scrollBox.CanvasPosition = Vector2.new(0, scrollBox.AbsoluteWindowSize.Y * 10)
end

local function stopRecording()
    isRecording = false
    statusLabel.Text = "Status: Stopped"
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    -- Matikan semua koneksi scanner
    for _, conn in ipairs(recordConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(recordConnections)
end

local function startRecording()
    if isRecording then return end
    logData = "-- [ STARTING ACTIVITY LOG ] --\n\n"
    logBox.Text = logData
    isRecording = true
    statusLabel.Text = "Status: 🔴 RECORDING..."
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    
    if not hum then 
        addLog("Error: Humanoid tidak ditemukan!")
        return 
    end

    -- 1. Track State (Jumping, Running, Died, dll)
    table.insert(recordConnections, hum.StateChanged:Connect(function(old, new)
        local stateName = string.gsub(tostring(new), "Enum.HumanoidStateType.", "")
        addLog("State Change: " .. stateName)
    end))

    -- 2. Track Animasi yang dimainkan
    table.insert(recordConnections, hum.AnimationPlayed:Connect(function(animTrack)
        if animTrack.Animation and animTrack.Animation.AnimationId then
            addLog("Anim Played: " .. tostring(animTrack.Animation.AnimationId))
        end
    end))

    -- 3. Track Tool (Item Equip & Use)
    table.insert(recordConnections, char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            addLog("Tool Equipped: " .. child.Name)
            
            -- Cek kapan tool itu ditekan (digunakan)
            table.insert(recordConnections, child.Activated:Connect(function()
                addLog("Tool Used: " .. child.Name)
            end))
        end
    end))

    table.insert(recordConnections, char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
            addLog("Tool Unequipped: " .. child.Name)
        end
    end))

    -- 4. Track Posisi setiap 2 Detik
    task.spawn(function()
        while isRecording do
            task.wait(2)
            if isRecording and char:FindFirstChild("HumanoidRootPart") then
                local pos = char.HumanoidRootPart.Position
                addLog(string.format("Position: X=%.1f, Y=%.1f, Z=%.1f", pos.X, pos.Y, pos.Z))
            end
        end
    end)
end

