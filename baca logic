btnExport.TextSize = 15
btnExport.Parent = main
Instance.new("UICorner", btnExport).CornerRadius = UDim.new(0, 6)

btnExport.MouseButton1Click:Connect(function()
    if scannedData == "" or scannedData == "-- Hasil scan akan muncul di sini --\n-- Siap diekspor ke .txt --" then
        btnExport.Text = "⚠️ SCAN DULU SEBELUM SAVE!"
        task.wait(1.5)
        btnExport.Text = "💾 SAVE TO .TXT (Scanner_Result.txt)"
        return
    end

    if writefile then
        local success, err = pcall(function()
            local fileName = "Scanner_Result_" .. math.random(1000,9999) .. ".txt"
            writefile(fileName, scannedData)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Tersimpan di Delta!";
                Text = "Cek folder workspace Delta kamu: " .. fileName;
                Duration = 5;
            })
        end)
        
        if success then
            btnExport.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            btnExport.Text = "✅ SUKSES DISIMPAN!"
        else
            btnExport.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            btnExport.Text = "❌ ERROR: " .. tostring(err)
        end
    else
        btnExport.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
        btnExport.Text = "⚠️ DELTA TIDAK BISA WRITEFILE SAAT INI"
    end
    
    task.wait(2)
    btnExport.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
    btnExport.Text = "💾 SAVE TO .TXT (Scanner_Result.txt)"
end)

